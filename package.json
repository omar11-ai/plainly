{
  "name": "plainly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first reader that turns dense text into plain language and proves it kept the meaning.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.mjs\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.mjs",
    "eval": "node eval/run-eval.mjs",
    "eval-passages": "node eval/run-passages.mjs",
    "bench": "node eval/bench-models.mjs",
    "verify-api": "node scripts/verify-api.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
